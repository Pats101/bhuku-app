# ---- Secrets ----
.env
*.env
!*.env.example

# ---- Markdown docs ----
# Ignore ALL markdown (ARCHITECTURE.md, PRD.md, tasks.md, progress.md,
# docs/*.md, etc.) EXCEPT the repo's public README, the project CLAUDE.md,
# and the .claude/ agent + skill definitions (the team must live in the repo).
*.md
!README.md
!CLAUDE.md
!ARCHITECTURE.md
!.claude/**/*.md

# ---- macOS ----
.DS_Store

# ---- Editors ----
.idea/
.vscode/
*.iml

# ---- Python / backend ----
__pycache__/
*.py[cod]
.venv/
.venv-test/
*.sqlite
.pytest_cache/
.mypy_cache/

# ---- Flutter / mobile ----
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/build/
mobile/.idea/
# Generated by build_runner (regenerate with `dart run build_runner build`)
*.g.dart
